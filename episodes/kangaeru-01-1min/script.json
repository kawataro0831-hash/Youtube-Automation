  "sentences": [
    {
      "id": "s0",
      "text": "1970年、アメリカ南部のケンタッキー州ルイビル。",
      "read": "せんきゅうひゃくななじゅうねん。アメリカ南部の、ケンタッキー州ルイビル。"
    },
    {
      "id": "s1",
      "text": "競馬場には酒の匂いが漂い、観客席では派手な帽子をかぶった人々が声を張り上げている。"
    },
    {
      "id": "s2",
      "text": "この場所に、一人の記者がやってきた。"
    },
    {
      "id": "s3",
      "text": "ハンター・S・トンプソン。",
      "read": "ハンター・エス・トンプソン。"
    },
    {
      "id": "s4",
      "text": "本来、記者というものは出来事の外側に立つ。"
    },
    {
      "id": "s5",
      "text": "しかしトンプソンは、まるで逆のことをやった。"
    },
    {
      "id": "s6",
      "text": "記者自身が出来事の中へ入り込み、ついには物語の一部になってしまう。"
    },
    {
      "id": "s7",
      "text": "彼の名前そのものが、一つのジャンルになっていった。"
    },
    {
      "id": "s8",
      "text": "最初は、本人がキャラクターを作っていた。"
    },
    {
      "id": "s9",
      "text": "しかし、いつしか、キャラクターの方が本人に「お前はこういう人間であり続けろ」と要求し始める。"
    },
    {
      "id": "s10",
      "text": "これは有名人だけの話ではない。"
    },
    {
      "id": "s11",
      "text": "自分らしさを確立した人間ほど、自分らしさから逃げられなくなるのではないか。"
    },
    {
      "id": "s12",
      "text": "今夜考えたいのは、この奇妙な問題である。"
    },
    {
      "id": "s13",
      "text": "なぜ人間は「自分らしさ」に殺されるのか？"
    }
  ],
